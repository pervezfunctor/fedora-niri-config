#!/usr/bin/env bash
#
# Create a Debian 13 (trixie) VM on the libvirt system connection
# (qemu:///system), bridged to the LAN so it gets an IP from your router.
#
# Uses the official Debian cloud image (generic) with virt-install, which
# builds a transient cloud-init ISO for first boot. Disks are libvirt-managed
# volumes in the 'default' pool, so the qemu process (qemu:qemu) can read them
# with correct SELinux labels. The whole flow is sudo-free.
#
# Prerequisites:
#   fgc libvirt        # installs @virtualization + libvirt group; starts libvirtd
#   a host bridge br0  # bridged to your primary NIC for LAN access (e.g. br0)
#   reboot / log out-in so the libvirt group is active in your shell
#
# The script creates the 'default' storage pool itself on first run.
#
# Usage:
#   debian-libvirt-vm create [--name N] [--cpus N] [--memory MB] [--disk GB]
#   debian-libvirt-vm ssh <name>
#
# Defaults: name=debian, cpus=2, memory=2048MB, disk=20GB

set -Eeuo pipefail

trap 'echo "ERROR rc=$? line=$LINENO cmd=$BASH_COMMAND" >&2' ERR

# --- Configuration -----------------------------------------------------------

CONNECT="${CONNECT:-qemu:///system}"
BRIDGE="${BRIDGE:-br0}"
POOL="${POOL:-default}"

SSH_USER="${SSH_USER:-$USER}"
SSH_KEY_NAME="libvirt_vm_ed25519"

DEBIAN_RELEASE="trixie"
DEBIAN_VERSION="13"
OS_VARIANT="debian13"
IMAGE_BASE_URL="https://cloud.debian.org/images/cloud/${DEBIAN_RELEASE}/latest"
BASE_VOL="debian-${DEBIAN_VERSION}-generic-base.qcow2"

DEFAULT_NAME="debian"
DEFAULT_CPUS=2
DEFAULT_MEMORY=2048
DEFAULT_DISK=20

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/debian-libvirt-vm"

# --- Helpers -----------------------------------------------------------------

log() {
  printf "\033[1;34m🚀 %s\033[0m\n" "$*"
}

error() {
  printf "\033[1;31m🔥 %s\033[0m\n" "$*" >&2
}

die() {
  error "$*"
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not installed. Run 'fgc libvirt' first."
}

# All libvirt calls go through the system connection.
v() {
  virsh -c "$CONNECT" "$@"
}

# --- Paths & image metadata --------------------------------------------------

image_name() {
  echo "debian-${DEBIAN_VERSION}-generic-amd64.qcow2"
}

ssh_key_path() {
  echo "$HOME/.ssh/${SSH_KEY_NAME}"
}

cloudinit_user_data_path() {
  echo "$CACHE_DIR/$1-user-data"
}

cloudinit_meta_data_path() {
  echo "$CACHE_DIR/$1-meta-data"
}

cloudinit_password_path() {
  echo "$CACHE_DIR/$1.password"
}

# --- VM state queries --------------------------------------------------------

vm_exists() {
  v domstate "$1" >/dev/null 2>&1
}

vol_exists() {
  v vol-info --pool "$POOL" "$1" >/dev/null 2>&1
}

require_bridge() {
  ip link show "$BRIDGE" >/dev/null 2>&1 \
    || die "Bridge '$BRIDGE' not found. Create a host bridge (e.g. via NetworkManager: nmcli con add type bridge ...)."
}

# Validate everything needed to create a VM, before any side effects. Each
# check dies with a actionable message on failure.
check_prerequisites() {
  local name="$1"

  # Commands used by the create flow.
  require_cmd virt-install
  require_cmd curl
  require_cmd openssl

  # libvirt system connection reachable (libvirt group + a running qemu daemon).
  # 'virsh uri' is the authoritative probe -- works with both monolithic
  # libvirtd and the modular daemon model.
  v uri >/dev/null 2>&1 \
    || die "Cannot reach libvirt at '$CONNECT'. Is your user in the 'libvirt' group? Run 'fgc libvirt' and re-login."

  # Host bridge for LAN access (br0 is root-owned; needs qemu:///system).
  require_bridge

  # Name collision -- fail before touching storage.
  vm_exists "$name" \
    && die "VM '$name' already exists. Pick another name or destroy it first." || true
}

# Ensure the 'default' storage pool exists, is built, started and autostarted.
# The pool is a dir at /var/lib/libvirt/images (created by the @virtualization
# package). fgc no longer sets this up, so we do it here. Sudo-free: the libvirt
# group can define/build/start pools. Volumes land here with qemu:qemu ownership
# and SELinux labels.
ensure_pool() {
  if v pool-info "$POOL" >/dev/null 2>&1; then
    return
  fi

  log "Creating storage pool '$POOL' (/var/lib/libvirt/images)..."
  v pool-define-as "$POOL" dir --target /var/lib/libvirt/images
  v pool-build "$POOL"
  v pool-start "$POOL"
  v pool-autostart "$POOL"
}

# Extract the first non-loopback, non-link-local IPv4 from a domifaddr table.
extract_first_ipv4() {
  awk '$3 == "ipv4" {
    split($4, a, "/")
    if (a[1] !~ /^(127|169\.254)\./) { print a[1]; exit }
  }'
}

# Prefer the qemu-guest-agent (reliable once the VM is up), fall back to ARP.
vm_ip() {
  local name="$1"
  local ip

  ip="$(v domifaddr "$name" --source agent 2>/dev/null | extract_first_ipv4)" || ip=""
  if [ -z "$ip" ]; then
    ip="$(v domifaddr "$name" --source arp 2>/dev/null | extract_first_ipv4)" || ip=""
  fi

  [ -n "$ip" ] || return 1
  echo "$ip"
}

# --- SSH key -----------------------------------------------------------------

# Ensure the dedicated VM SSH key pair exists and return the public key (no
# trailing newline).
ensure_ssh_pubkey() {
  local pub
  pub="$(ssh_key_path).pub"
  if [ ! -f "$pub" ]; then
    log "Generating dedicated VM SSH key pair ($(ssh_key_path))..."
    ssh-keygen -t ed25519 -f "$(ssh_key_path)" -q -N "" -C "${USER}@libvirt-vm"
  fi
  tr -d '\n' <"$pub"
}

# --- Image & volumes ---------------------------------------------------------

fetch_image() {
  local target="$1"

  if [ -f "$target" ]; then
    log "Base image cached: $target"
    return
  fi

  mkdir -p "$(dirname "$target")"
  log "Downloading Debian ${DEBIAN_VERSION} cloud image..."
  curl -fL --retry 3 -o "$target" "${IMAGE_BASE_URL}/$(image_name)"
}

# Ensure the base cloud image exists as a volume in the default pool. libvirt
# sets the qemu:qemu ownership and SELinux virt_image_t label on it.
ensure_base_volume() {
  if vol_exists "$BASE_VOL"; then
    log "Base volume already in pool '$POOL': $BASE_VOL"
    return
  fi

  local cached
  cached="$CACHE_DIR/$(image_name)"
  fetch_image "$cached"

  log "Uploading base image into pool '$POOL' as '$BASE_VOL'..."
  v vol-create-as "$POOL" "$BASE_VOL" 0 --format qcow2 >/dev/null
  v vol-upload "$BASE_VOL" "$cached" "$POOL"
}

# Create the VM's overlay disk as a pool volume backed by the base volume.
create_overlay_volume() {
  local name="$1"
  local disk_gb="$2"
  local vol="${name}.qcow2"

  if vol_exists "$vol"; then
    log "Volume '$vol' already exists in pool '$POOL'"
    return
  fi

  log "Creating overlay volume '$vol' (${disk_gb}GB, backed by $BASE_VOL)..."
  v vol-create-as "$POOL" "$vol" "${disk_gb}G" --format qcow2 \
    --backing-vol "$BASE_VOL" --backing-vol-format qcow2 >/dev/null
}

# --- Cloud-init --------------------------------------------------------------

# Write the cloud-init user-data, meta-data and password files for the VM.
# virt-install's --cloud-init bakes user-data + meta-data into a transient ISO
# that is attached for first boot only. The password file is for the operator
# (printed at create time) -- the cloud image locks all accounts by default.
write_cloudinit() {
  local name="$1"
  local ssh_key="$2"

  mkdir -p "$CACHE_DIR"

  local password password_hash
  password="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)"
  password_hash="$(openssl passwd -6 "$password")"
  printf '%s' "$password" >"$(cloudinit_password_path "$name")"

  cat >"$(cloudinit_user_data_path "$name")" <<EOF
#cloud-config
hostname: ${name}
manage_etc_hosts: true
users:
  - name: ${SSH_USER}
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    passwd: ${password_hash}
    ssh_authorized_keys:
      - ${ssh_key}
package_update: true
packages:
  - qemu-guest-agent
  - openssh-server
  - curl
  - wget
runcmd:
  - systemctl enable --now qemu-guest-agent || true
  - systemctl enable --now ssh || true
EOF

  cat >"$(cloudinit_meta_data_path "$name")" <<EOF
instance-id: ${name}
local-hostname: ${name}
EOF
}

# Remove the per-VM cloud-init artifacts from the cache.
remove_cloudinit() {
  local name="$1"
  rm -f "$(cloudinit_user_data_path "$name")" \
        "$(cloudinit_meta_data_path "$name")" \
        "$(cloudinit_password_path "$name")" 2>/dev/null || true
}

# --- Commands ----------------------------------------------------------------

cmd_create() {
  local name="$DEFAULT_NAME"
  local cpus="$DEFAULT_CPUS"
  local memory="$DEFAULT_MEMORY"
  local disk="$DEFAULT_DISK"

  while [ $# -gt 0 ]; do
    case "$1" in
    --name) name="${2:?--name requires a value}"; shift 2 ;;
    --name=*) name="${1#*=}"; shift ;;
    --cpus) cpus="${2:?--cpus requires a value}"; shift 2 ;;
    --cpus=*) cpus="${1#*=}"; shift ;;
    --memory) memory="${2:?--memory requires a value}"; shift 2 ;;
    --memory=*) memory="${1#*=}"; shift ;;
    --disk) disk="${2:?--disk requires a value}"; shift 2 ;;
    --disk=*) disk="${1#*=}"; shift ;;
    --help | -h) cmd_create_help; return 0 ;;
    *) die "Unknown option: $1 (see 'create --help')" ;;
    esac
  done

  # Reject empty values (e.g. --name= ).
  local var
  for var in name cpus memory disk; do
    [ -n "${!var}" ] || die "Invalid value for --${var} (empty). See 'create --help'."
  done

  check_prerequisites "$name"

  local pubkey
  pubkey="$(ensure_ssh_pubkey)"

  ensure_pool
  ensure_base_volume
  create_overlay_volume "$name" "$disk"
  write_cloudinit "$name" "$pubkey"

  # UEFI (non-secure-boot): the generic cloud image boots unreliably under
  # SeaBIOS on some hosts. firmware=efi + smm.state=off selects OVMF without
  # Secure Boot. Serial console so 'virsh console' works and cloud-init output
  # is visible.
  log "Creating VM '$name' (cpus=$cpus, memory=${memory}MB, disk=${disk}GB) on '$BRIDGE'..."
  virt-install --connect "$CONNECT" \
    --name "$name" \
    --cpu host-passthrough \
    --vcpus "$cpus" \
    --memory "$memory" \
    --os-variant "$OS_VARIANT" \
    --import \
    --disk "vol=${POOL}/${name}.qcow2,bus=virtio" \
    --network "bridge=${BRIDGE},model=virtio" \
    --boot firmware=efi \
    --features smm.state=off \
    --cloud-init "user-data=$(cloudinit_user_data_path "$name"),meta-data=$(cloudinit_meta_data_path "$name"),disable=on" \
    --graphics none \
    --console pty,target_type=serial \
    --noautoconsole

  log "VM '$name' created. Cloud-init runs on first boot (~1-2 min)."
  log "  console password for '${SSH_USER}': $(cat "$(cloudinit_password_path "$name")")"
  log "  virsh -c $CONNECT console $name   # watch cloud-init progress"
  log "  debian-libvirt-vm ssh $name       # ssh in once an IP is assigned"
}

cmd_create_help() {
  cat <<EOF
Usage: debian-libvirt-vm create [options]

Create a Debian 13 (trixie) VM on qemu:///system, bridged to '$BRIDGE'.

Options:
  --name NAME       VM name           (default: $DEFAULT_NAME)
  --cpus N          Number of vCPUs   (default: $DEFAULT_CPUS)
  --memory MB       Memory in MB      (default: $DEFAULT_MEMORY)
  --disk GB         Disk size in GB   (default: $DEFAULT_DISK)
  -h, --help        Show this help

Flags accept either form: --cpus 4  or  --cpus=4

Examples:
  debian-libvirt-vm create                        # all defaults
  debian-libvirt-vm create --name build --cpus 4
  debian-libvirt-vm create --name big --memory 8192 --disk 50
EOF
}

cmd_ssh() {
  local name="$1"
  local ip
  ip="$(vm_ip "$name")" \
    || die "No IP found for VM '$name'. Is the guest agent up? Try: virsh -c $CONNECT console $name"

  log "SSHing into ${SSH_USER}@${ip} (key: $(ssh_key_path))"
  exec ssh -i "$(ssh_key_path)" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null "${SSH_USER}@${ip}"
}

cmd_destroy() {
  local name="$1"
  vm_exists "$name" || die "VM '$name' does not exist."

  v destroy "$name" 2>/dev/null || true
  # UEFI VMs have nvram; plain undefine fails on them. Fall back to --nvram.
  v undefine "$name" 2>/dev/null || v undefine "$name" --nvram 2>/dev/null || true

  if vol_exists "${name}.qcow2"; then
    v vol-delete --pool "$POOL" "${name}.qcow2" 2>/dev/null || true
  fi
  remove_cloudinit "$name"
  log "Destroyed VM '$name' and its disk."
}

cmd_ip() {
  local name="$1"
  local ip
  ip="$(vm_ip "$name")" \
    || die "No IP found for VM '$name'. Is the guest agent up? Try: virsh -c $CONNECT console $name"
  echo "$ip"
}

cmd_start() {
  v start "${1:?VM name required}"
}

cmd_stop() {
  v shutdown "${1:?VM name required}"
}

cmd_restart() {
  v reboot "${1:?VM name required}"
}

cmd_list() {
  v list --all
}

cmd_help() {
  cat <<EOF
Usage: debian-libvirt-vm <command> [args...]

Commands:
  create [options] Create a Debian 13 VM (see 'create --help' for options)
  ssh <name>       SSH into a VM
  destroy <name>   Stop and delete a VM, its disk volume and cloud-init files
  start <name>     Start a VM
  stop <name>      Shut down a VM
  restart <name>   Restart a VM
  list             List VMs
  ip <name>        Print the VM's IP address
  help             Show this help message

The VM is bridged to '$BRIDGE' and gets an IP from your router via DHCP.
Prerequisites: 'fgc libvirt' (installs @virtualization + libvirt group), a host
bridge named '$BRIDGE', then reboot so the libvirt group is active.
The 'default' storage pool is created automatically on first run.

Environment:
  CONNECT    libvirt URI (default: $CONNECT)
  BRIDGE     host bridge to attach to (default: $BRIDGE)
  POOL       libvirt storage pool (default: $POOL)
  SSH_USER   cloud-init user (default: $SSH_USER)
EOF
}

# --- Dispatch ----------------------------------------------------------------

case "${1:-create}" in
create) shift; cmd_create "$@" ;;
ssh) cmd_ssh "${2:?VM name required}" ;;
destroy) cmd_destroy "${2:?VM name required}" ;;
start) cmd_start "${2:?VM name required}" ;;
stop) cmd_stop "${2:?VM name required}" ;;
restart) cmd_restart "${2:?VM name required}" ;;
list) cmd_list ;;
ip) cmd_ip "${2:?VM name required}" ;;
help | -h | --help) cmd_help ;;
*)
  error "Unknown command: $1"
  cmd_help
  exit 1
  ;;
esac
